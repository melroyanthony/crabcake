# Generated by cargo-generate. Review before deploying, and never commit real
# production secrets to a public repository.

ENVIRONMENT=local
PROJECT_NAME="{{project_title}}"
STACK_NAME={{project-name}}

# Domains
DOMAIN=localhost
FRONTEND_HOST=http://localhost:3000
BACKEND_HOST=http://localhost:8000
# Comma-separated list of origins allowed to call the API directly
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Backend
BIND_ADDRESS=0.0.0.0:8000
RUST_LOG=info,app=debug,tower_http=debug,sqlx=warn
SECRET_KEY={{secret_key}}
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1
RATE_LIMIT_PER_SECOND=20
RATE_LIMIT_BURST=50

FIRST_SUPERUSER={{first_superuser}}
FIRST_SUPERUSER_PASSWORD={{first_superuser_password}}

# Postgres
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD={{postgres_password}}
DATABASE_URL=postgres://postgres:{{postgres_password}}@localhost:5432/app

# Email. Locally these point at Mailcatcher, which accepts anything.
SMTP_HOST={% if smtp_host == "" %}mailcatcher{% else %}{{smtp_host}}{% endif %}
SMTP_PORT=1025
SMTP_USER={{smtp_user}}
SMTP_PASSWORD={{smtp_password}}
SMTP_TLS=false
EMAILS_FROM_NAME="{{project_title}}"
EMAILS_FROM_EMAIL={{emails_from_email}}
{% if enable_s3 %}
# Object storage. Locally these point at MinIO.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET={{project-name}}-uploads
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
{% endif %}{% if enable_otel %}
# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME={{project-name}}-api
METRICS_ENABLED=true
{% endif %}
SENTRY_DSN={{sentry_dsn}}

# Frontend
NEXT_PUBLIC_APP_NAME="{{project_title}}"
API_URL=http://backend:8000

# Docker images, used by the deployment workflows
DOCKER_IMAGE_BACKEND={{project-name}}-backend
DOCKER_IMAGE_FRONTEND={{project-name}}-frontend
TAG=latest
